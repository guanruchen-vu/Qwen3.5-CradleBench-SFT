# Sensitive or large local artifacts are not part of this code-and-aggregate-results release.
/data/
/outputs/**/*
!/outputs/qwen35-*/
!/outputs/qwen35-*/**/
!/outputs/qwen35-*/**/*.md
!/outputs/qwen35-*/**/*.csv
!/outputs/qwen35-*/**/*.png
!/outputs/figures/
!/outputs/figures/*.pdf
!/outputs/figures/*.png
!/outputs/validation-loss/
!/outputs/validation-loss/*.csv
!/outputs/validation-loss/*.md

# Gemma 4 and Llama 3.1 aggregate results (same rules as Qwen3.5)
!/outputs/gemma4-*/
!/outputs/gemma4-*/**/
!/outputs/gemma4-*/**/*.md
!/outputs/gemma4-*/**/*.csv
!/outputs/gemma4-*/**/*.png
!/outputs/llama31-*/
!/outputs/llama31-*/**/
!/outputs/llama31-*/**/*.md
!/outputs/llama31-*/**/*.csv
!/outputs/llama31-*/**/*.png
# Training-run directories (checkpoints, adapters, auto-generated adapter READMEs) stay local
/outputs/*-lora-sft-*/
# Re-runs saved with a timestamp suffix
/outputs/*/test-bootstrap-ci-*-20*T*Z/

__pycache__/
._*
.DS_Store
*.py[cod]
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.jsonl
env.sh
.env
.env.*
*.pem
*.key
id_ed25519*
